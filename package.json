{
  "name": "kwami",
  "version": "2.1.1",
  "description": "3D AI companion library with voice, memory, and tools",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "clean": "rm -rf dist coverage playwright-report test-results",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,js,mjs,json,md,yml,yaml}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci-scripts": "node --test \"scripts/ci/*.test.mjs\"",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:run": "vitest run --config vitest.config.ts --passWithNoTests",
    "audit:ci": "node scripts/ci/check-audit.mjs",
    "rules:apply": "node scripts/ci/apply-branch-rules.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release:baseline": "node scripts/release/ensure-baseline-tag.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "voice",
    "agent",
    "companion",
    "3d",
    "threejs",
    "livekit",
    "mcp"
  ],
  "author": "Alex Colls",
  "license": "Apache-2.0",
  "dependencies": {
    "livekit-client": "^2.6.0",
    "simplex-noise": "^4.0.3",
    "three": ">=0.183.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "25.3.5",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "three": ">=0.183.2"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.18",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18",
      "conventional-changelog-conventionalcommits": "9.3.1"
    }
  }
}
